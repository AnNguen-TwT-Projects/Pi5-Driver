digraph G {
  rankdir=TB; bgcolor=white; nodesep=0.5; ranksep=0.3;
  node [shape=box, style="rounded,filled", fillcolor="#ffffff", fontname="Liberation Serif", fontsize=12, penwidth=1.2];
  edge [fontname="Liberation Serif", fontsize=10.5, penwidth=1.2];

  press [label="Button\npressed\n(contact bounces)", shape=ellipse, fillcolor="#eef7f0"];
  isr [label="btn_isr()\n(hard IRQ context)\nmod_delayed_work(30 ms)", fillcolor="#ffe0cc"];
  work [label="btn_debounce()\n(process context)\nread stable level", fillcolor="#ffe0cc"];
  dec [label="pressed now and\nreleased before?", shape=diamond, fillcolor="#fff3d6"];
  fifo [label="kfifo (16 events)\n+ spinlock\npush '1'..'4'", fillcolor="#fff3d6"];
  wq [label="wake_up_interruptible()\nwait queue", fillcolor="#fff3d6"];
  rd [label="read() / poll()\nin user program", fillcolor="#eef3fa"];
  drop [label="no event\n(release or\nstill held)", shape=plaintext];

  press -> isr [label="each edge\n(rising + falling)"];
  isr -> isr [label="new edge:\ntimer restarts", style=dashed];
  isr -> work [label="30 ms\nwithout edges"];
  work -> dec;
  dec -> fifo [label="yes"];
  dec -> drop [label="no", style=dashed];
  fifo -> wq -> rd;
}
