digraph G {
  rankdir=TB; bgcolor=white; nodesep=0.4; ranksep=0.28;
  node [shape=box, style="rounded,filled", fillcolor="#ffffff", fontname="Liberation Serif", fontsize=12, penwidth=1.2, width=3.4];
  edge [fontname="Liberation Serif", fontsize=10.5, penwidth=1.1];

  start [label="Kernel finds DT node with\ncompatible = \"twt,lcd2004-btn\" → lcd_probe()", shape=box, style="filled", fillcolor="#eef3fa"];
  s1 [label="Check adapter supports SMBus byte write"];
  s2 [label="devm_kzalloc(struct lcd2004), mutex_init()"];
  s3 [label="pcf_write(0): turn backlight on, test that LCD answers"];
  s4 [label="lcd_init(): 0x3, 0x3, 0x3, 0x2, then 0x28 0x08 0x01 0x06 0x0C"];
  s5 [label="Print welcome screen on rows 0, 1, 3"];
  s6 [label="devm_gpiod_get_array(\"button\"): exactly 4 GPIOs"];
  s7 [label="INIT_KFIFO, spin_lock_init, init_waitqueue_head"];
  s8 [label="For each button: INIT_DELAYED_WORK,\ngpiod_to_irq, devm_request_irq (both edges)"];
  s9 [label="misc_register() → /dev/lcd2004"];
  ok [label="dev_info: \"probe ok\"", style="filled", fillcolor="#eef7f0"];
  err [label="Return error code\n(devm frees memory;\nlcd_btns_stop() stops IRQs and works\nalready set up)", style="filled", fillcolor="#fde2e2"];

  start -> s1 -> s2 -> s3 -> s4 -> s5 -> s6 -> s7 -> s8 -> s9 -> ok;
  {s1 s3 s4 s5 s6 s8 s9} -> err [style=dashed, color="#b04040"];
  {rank=same; s6; err}
}
