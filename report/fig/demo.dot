digraph G {
  rankdir=LR; bgcolor=white; nodesep=0.6; ranksep=0.9;
  node [shape=box, style="rounded,filled", fillcolor="#ffffff", fontname="Liberation Serif", fontsize=12, penwidth=1.3];
  edge [fontname="Liberation Serif", fontsize=10.5, penwidth=1.1];

  init [shape=point, width=0.15];
  XC [label="XIN_CHAO\n\"Xin Chao\" scrolls\nforever on row 1", fillcolor="#eef3fa"];
  DS [label="DSTV\nmember list\n\"1  2  3  4\"\n(wait for a key)", fillcolor="#fff3d6"];
  SC [label="SCROLL(k)\n\"Name - ID\" of member k\nscrolls once on row 1", fillcolor="#ffe0cc"];
  IN [label="INFO(k)\nname (row 1) and ID (row 2)\nstatic for 10 s", fillcolor="#eef7f0"];

  init -> XC;
  XC -> XC [label="tick 200 ms"];
  XC -> DS [label="any key"];
  DS -> SC [label="key k"];
  SC -> SC [label="tick 200 ms"];
  SC -> IN [label="one pass\nfinished"];
  IN -> SC [label="key k", constraint=false];
  IN -> DS [label="10 s without key"];
}
